# ---------------------------------------------------------------------------
# Ascent — environment variables. Copy to .env.local and fill in.
# NEVER commit real secrets. All AI/DB secrets are server-side only.
# ---------------------------------------------------------------------------

# Neon Postgres (works locally and on Vercel). Use the pooled connection string.
# Get one at https://console.neon.tech  ->  Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ascent?sslmode=require"

# NextAuth. Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# In production set this to your deployed URL, e.g. https://ascent.vercel.app
# AUTH_URL="http://localhost:3000"

# OpenRouter — server-side ONLY. Never expose to the client bundle.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional attribution headers (recommended by OpenRouter):
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Ascent"

# Set to "1" to force cached/offline curriculum + static fallbacks (useful for
# a guaranteed-working demo when live models are rate-limited during judging).
ASCENT_OFFLINE_FALLBACK="0"
